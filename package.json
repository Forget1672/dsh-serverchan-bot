{
  "name": "dsh-serverchan-bot",
  "version": "1.3.3",
  "description": "Bridge DeepSeek Harness with Server酱³ Bot: push agent and scheduled output to the phone, answer question/approval cards from either side, run polling or webhook (with a cloudflared tunnel helper), and configure everything in Settings.",
  "license": "MIT",
  "author": "Forget1672",
  "type": "module",
  "engines": {
    "dsh": "^0.2.2-rc.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Forget1672/dsh-serverchan-bot.git"
  },
  "homepage": "https://github.com/Forget1672/dsh-serverchan-bot#readme",
  "bugs": {
    "url": "https://github.com/Forget1672/dsh-serverchan-bot/issues"
  },
  "keywords": [
    "dsh-plugin",
    "serverchan",
    "bot",
    "push",
    "chat"
  ],
  "exports": {
    ".": "./index.js",
    "./api": "./api.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "api.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
